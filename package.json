{
  "name": "@cronocode/react-box",
  "version": "3.3.3",
  "type": "module",
  "main": "./box.cjs",
  "module": "./box.mjs",
  "types": "./box.d.ts",
  "exports": {
    ".": {
      "types": "./box.d.ts",
      "import": "./box.mjs",
      "require": "./box.cjs"
    },
    "./ssg": {
      "types": "./ssg.d.ts",
      "import": "./ssg.mjs",
      "require": "./ssg.cjs"
    },
    "./components/*": {
      "types": "./components/*.d.ts",
      "import": "./components/*.mjs",
      "require": "./components/*.cjs"
    },
    "./types": {
      "types": "./types.d.ts"
    }
  },
  "scripts": {
    "dev": "vite ./pages --config ./pages.vite.config.ts --mode dev",
    "build:pages": "vite build ./pages --config ./pages.vite.config.ts --outDir ../dist --mode production",
    "postbuild:pages": "cp ./dist/index.html ./dist/404.html",
    "preview": "vite preview",
    "build": "vite build",
    "postbuild": "cp package.json dist && cp LICENSE dist && cp README.md dist && cp src/BOX_AI_CONTEXT.md dist && mkdir -p dist/.claude/skills/cronocode-react-box dist/.claude/rules && cp .claude/skills/cronocode-react-box/SKILL.md dist/.claude/skills/cronocode-react-box/ && cp .claude/rules/react-box-rules.md dist/.claude/rules/",
    "build:dev": "vite build --mode dev",
    "compile": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cronocodesolutions/react-box.git"
  },
  "keywords": [
    "react",
    "box"
  ],
  "author": "Maxim Procopenco",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cronocodesolutions/react-box/issues"
  },
  "homepage": "https://github.com/cronocodesolutions/react-box#readme",
  "description": "",
  "peerDependencies": {
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@cronocode/identity-factory": "^0.0.6",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/use-sync-external-store": "^1.5.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "framer-motion": "^12.40.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "lucide-react": "^1.17.0",
    "prettier": "^3.8.3",
    "prismjs": "^1.30.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7"
  }
}
